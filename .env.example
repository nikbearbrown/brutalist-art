# brutalist-art — environment. Copy to .env (gitignored) and fill what you need.
# Everything lives here. Skills read these; the doctor (Phase 4 `./setup`) checks them.
# A key you leave blank simply disables the features that need it — nothing breaks.

# ── Narration (ElevenLabs) — unlocks ALL narrated video ──────────────────────
# Needed by: explainer, sketch-explainer, math-explainer, bio, kids-video,
#            story-film, recitation-film, code-walkthrough, youtube-publisher audio.
# Cost: PAID.  Get it: https://elevenlabs.io  (Profile → API key)
ELEVENLABS_API_KEY=

# Which cloned voice speaks (IDs from your ElevenLabs voice library). Optional but
# recommended; audience-preset picks per brand.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NIKBEARBROWN=
ELEVENLABS_VOICE_MEDHAVY=
ELEVENLABS_VOICE_HUMANITARIANS=
ELEVENLABS_VOICE_NEU=
# ELEVENLABS_MODEL_ID=            # optional TTS model override

# ── AI image / video ─────────────────────────────────────────────────────────
# The scripts call the external `higgsfield` CLI (run `higgsfield auth login` once);
# these vars are here so you can also pass credentials via the environment if your
# setup prefers it. Leave blank to rely on the CLI login. Unlocks: lyric-resync,
# dance-video, bio photoreal footage, explainer AI-video beats, ai-asset-gen.
# Cost: PAID.
HIGGSFIELD_API_KEY=
MINIMAX_API_KEY=

# fal.ai — optional style-LoRA / alternate image path. PAID. https://fal.ai
FAL_KEY=

# ── YouTube publishing ───────────────────────────────────────────────────────
# youtube-publisher uses Google Desktop OAuth, NOT an API key. Credentials live per
# channel in youtube/credentials/<channel>/ (gitignored). Pick the channel here:
ART_YOUTUBE_CHANNEL=nikbearbrown
# Each youtube/credentials/<channel>/ holds:
#   client_secret.json          (GCP console → YouTube Data API v3 → OAuth Desktop client)
#   youtube_token.json          (auto-created/cached on first authorized publish)
#   youtube_publish_ledger.json (per-channel record of what has been uploaded)
# Most people have one channel; add more folders (hai/, medhavy/, …) for multiple.
# Optional explicit overrides (leave unset to use the channel folder above):
# ART_YOUTUBE_CLIENT_SECRET=
# ART_YOUTUBE_TOKEN=
# ART_PUBLISH_LEDGER=

# ── Local workspace paths (no cost; override only if you keep things elsewhere) ─
# ART_HOME is set automatically by ./art; set it only when calling scripts directly.
# ART_HOME=.
ART_VENV=./.venv                 # python venv the scripts expect (was ~/ai)
ART_ASSETS=./assets              # validated shared assets (was ~/ai/assets)
ART_PUBLISH_WORKSPACE=./publish-workspace

# ── Local render toggles (no cost) ───────────────────────────────────────────
# ART_PALETTE=teardown           # teardown|newsprint|neu|medhavy|humanitarians
# ART_NO_DRAWTEXT=1              # force the Pillow caption path (ffmpeg w/o drawtext)
# ART_CHROME=/path/to/chrome     # Chromium for Remotion render
# ART_CHROME_MODE=headless
