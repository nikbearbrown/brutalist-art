#!/usr/bin/env bash
# art — one entry point for the whole toolkit.
#
#   ./art --list                 list every skill (and its former name)
#   ./art <skill> --help         show a skill's SKILL.md
#   ./art <skill> <target> ...   run a skill (old house names resolve via GLOSSARY.md)
#   ./art todo <reel> [flags]    per-video beat ledger (which beats need filling, how)
#   ./art run <reel> [flags]     compile a reel (wraps runtime/scripts/run.sh)
#   ./art shorts <reel> [flags]  derive the 9:16 Short (cap check + auto-shorten)
#   ./art final <reel>           clean master cut — no review label (→ <slug>-cut.mp4)
#   ./art keys                   validate every key LIVE and FREE (no spend)
#   ./art doctor                 dependency + key readiness (Phase 4)
#
# Old names still work: `./art vox-explainer ...` dispatches to `explainer`.
set -euo pipefail

ART_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ART_HOME
# load .env (repo-root) so every dispatched skill sees the keys — shell still wins
[ -f "$ART_HOME/.env" ] && set -a && . "$ART_HOME/.env" 2>/dev/null && set +a || true
SKILLS="$ART_HOME/skills"
GLOSSARY="$ART_HOME/GLOSSARY.md"

# --- alias resolution: read the "| old | new |" rows out of GLOSSARY.md -------
resolve() {
  local q="$1"
  # exact new-name match wins
  if find "$SKILLS" -maxdepth 2 -type d -name "$q" | grep -q .; then echo "$q"; return; fi
  # else map old -> new from the glossary table (first backticked col -> second)
  local hit
  hit="$(awk -F'|' -v q="$q" '
    /\| *`?[a-z0-9-]+`? *\|/ {
      o=$2; n=$3; gsub(/[` ]/,"",o); gsub(/[` ]/,"",n);
      if (o==q && n!="" && n!="—") { print n; exit }
    }' "$GLOSSARY" 2>/dev/null || true)"
  echo "${hit:-$q}"
}

skill_dir() {
  find "$SKILLS" -maxdepth 2 -type d -name "$1" | head -1
}

cmd="${1:-}"; shift || true

case "$cmd" in
  ""|-h|--help|help)
    sed -n '2,14p' "$ART_HOME/art" | sed 's/^# \{0,1\}//'
    ;;
  --list|list)
    printf '%-26s %s\n' "SKILL" "(former name)"
    for d in "$SKILLS"/*/*/; do
      name="$(basename "$d")"
      old="$(awk -F'|' -v n="$name" '{o=$2;x=$3;gsub(/[` ]/,"",o);gsub(/[` ]/,"",x); if(x==n && o!=n && o!=""){print o; exit}}' "$GLOSSARY" 2>/dev/null || true)"
      printf '%-26s %s\n' "$name" "${old:+(was $old)}"
    done
    ;;
  todo)
    exec python3 "$ART_HOME/runtime/scripts/todo.py" "$@"
    ;;
  keys)
    exec python3 "$ART_HOME/runtime/scripts/check_keys.py" "$@"
    ;;
  run)
    exec bash "$ART_HOME/runtime/scripts/run.sh" "$@"
    ;;
  shorts)
    # 9:16 derivative cut: cap check, auto-shorten over 3:00, pantry overrides
    exec python3 "$ART_HOME/runtime/scripts/shorts.py" "$@"
    ;;
  final)
    # clean master (no --review label). Defaults to full-res 1080 unless the caller sets --height.
    case " $* " in
      *" --height "*) exec python3 "$ART_HOME/runtime/scripts/compile.py" "$@" ;;
      *)              exec python3 "$ART_HOME/runtime/scripts/compile.py" "$@" --height 1080 ;;
    esac
    ;;
  doctor)
    if [ -x "$ART_HOME/setup" ]; then exec "$ART_HOME/setup" "$@"; else
      echo "doctor arrives in Phase 4 (setup)"; exit 0; fi
    ;;
  *)
    name="$(resolve "$cmd")"
    dir="$(skill_dir "$name")"
    [ -z "$dir" ] && { echo "art: unknown skill '$cmd' (try ./art --list)"; exit 2; }
    if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
      exec "${PAGER:-cat}" "$dir/SKILL.md"
    fi
    echo "art: '$name' → $dir/SKILL.md"
    echo "This skill is agent-driven: open its SKILL.md in your CLI and follow the phases."
    echo "Runtime scripts live in runtime/scripts/ (call via python3, or use ./art run <reel>)."
    ;;
esac
